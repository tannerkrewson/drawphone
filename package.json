{
    "name": "drawphone",
    "version": "1.0.0",
    "description": "Telephone with pictures",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tannerkrewson/drawphone.git"
    },
    "author": "Tanner Krewson",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/tannerkrewson/drawphone/issues"
    },
    "homepage": "https://github.com/tannerkrewson/drawphone#readme",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --mode nova && node -e \"if (require('fs').statSync('dist/drawphone.html').size > 2 * 1024 * 1024) throw Error('Nova HTML exceeds 2 MiB')\"",
        "test": "vite build --mode nova && vitest run",
        "format": "oxfmt --check",
        "lint": "oxlint",
        "typecheck": "tsc --noEmit",
        "prepare": "lefthook install"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@mapbox/polyline": "^1.2.1",
        "bootstrap": "^4.6.2",
        "dexie": "^4.4.7",
        "fabric": "^7.4.0",
        "fflate": "^0.8.3",
        "jquery": "^4.1.0",
        "knuth-shuffle": "^1.0.8",
        "pug": "^3.0.3",
        "simplify-js": "^1.2.4",
        "striptags": "^3.2.0",
        "typeface-pangolin": "^1.1.13"
    },
    "devDependencies": {
        "@types/jquery": "^4.0.1",
        "@types/mapbox__polyline": "^1.0.5",
        "@types/node": "^26.6.11",
        "@types/pug": "^2.0.10",
        "@types/striptags": "^0.0.5",
        "@vitest/browser-playwright": "^5.1.2",
        "lefthook": "^2.2.4",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "playwright": "^1.65.1",
        "typescript": "^7.0.2",
        "vite": "^8.4.0",
        "vite-plugin-singlefile": "^2.3.4",
        "vitest": "^5.1.2"
    }
}
