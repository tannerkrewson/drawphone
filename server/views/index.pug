extends layout

block js
  script(type='module' src='/client/client.js')

block content
  .mt-3.mb-2
    img.mr-1.pencil-icon(src=icon('pencil') alt='' width='18')
    img.ml-1.phone-icon(src=icon('phone-flip') alt='' width='18')
  h1#title Drawphone
  p#subtitle Telephone with pictures
  hr
  p#game-error.text-danger(role='alert')
  div#lobby.d-none
    div.row.justify-content-center.mb-4.mt-3
      div.col-sm-8
        h5 Players
        ul#lobby-players.list-unstyled.row
      .mt-2.btn-group-vertical(role="group" aria-label="...")
        button#archivebtn.btn.btn-default(type='button') View Results Archive
        button#lobby-prevres.btn.btn-default(type='button').d-none View Last Round's Results
    div.row.justify-content-center.mb-3
      div#lobby-settings.col-sm-8.d-none
        h5 Options
        label Word pack:
        select.form-control.lobby-setting#lobby-settings-wordpack.mb-2
        label Drawing time limit:
        .btn-toolbar.mb-3
          button#timelimit-minus.lobby-setting.btn.btn-default -
          span#lobby-settings-timelimit Loading...
          button#timelimit-plus.lobby-setting.btn.btn-default +
        label Number of turns:
        .btn-toolbar
          button#turnlimit-minus.lobby-setting.btn.btn-default -
          span#lobby-settings-turnlimit Loading...
          button#turnlimit-plus.lobby-setting.btn.btn-default +
        p#lobby-settings-gametime
        .checkboxes.mt-1.mb-2
          .custom-control.custom-switch
            input#lobby-settings-wordfirst.custom-control-input.lobby-setting(type='checkbox')
            label.custom-control-label(for='lobby-settings-wordfirst') Players write first word
          .custom-control.custom-switch.mt-2
            input#lobby-settings-mature.custom-control-input.lobby-setting(type='checkbox')
            label.custom-control-label(for='lobby-settings-mature') Include 13+ and 18+ word packs
    .btn-toolbar.mb-4
      button#lobby-start.btn.btn-default.btn-lg.d-none(type='button') Start Game
    dialog#demo-confirm(aria-labelledby='demo-title')
      form(method='dialog')
        h5#demo-title Demo mode
        p Would you like to play Drawphone with just yourself to see how it works?
        .btn-toolbar
          button.btn.btn-default.mr-2(value='cancel' autofocus) Cancel
          button.btn.btn-default(value='start') Start Game
  div#game.d-none
    div#game-drawing.d-none
      h5#game-timer
      p#game-ink(role="status")
      canvas#game-drawing-canvas.drawing(width='600', height='600')
    div#game-word.d-none
      img#game-word-drawingtoname.drawing(alt="Drawing to guess")
      p#game-drawing-status(role="status")
      br
      br
      div Enter your answer here:
      input#game-word-in.form-control(type='text', placeholder='Tap here to type!', autocomplete='off', maxlength=50)
    div.row#game-draw-buttons.d-none
      div.col-md-6.mt-2
        div.input-group
          div.input-group-prepend
            span.input-group-text Color
          input#game-drawing-color.form-control(type='color', value='#000000')
          button#game-drawing-recent-color1.form-control(style='background-color: #c71818;')
          button#game-drawing-recent-color2.form-control(style='background-color: #10AC10;')
          button#game-drawing-recent-color3.form-control(style='background-color: #1a79af;')
      div.col-md-6.mt-2
        div.input-group
          div.input-group-prepend
            span.input-group-text Size
          .form-control(style='display: flex;justify-content: center;')
            input#game-drawing-brushsize(type='range', value='5', min='1', max='60')
    .btn-toolbar#game-buttons.mt-3
      button#game-drawing-undo.btn.btn-default.btn-lg.disabled.mr-2(type='button') Undo
      button#game-drawing-redo.btn.btn-default.btn-lg.disabled.mr-2(type='button') Redo
      button#game-send.btn.btn-default.btn-lg(type='button') Done
  include results.pug
  #archive.d-none
    #archive-content.btn-group-vertical
    .btn-toolbar.mt-3
      button#archive-back.btn.btn-default.mr-2(type='button') Back
      a.btn.btn-default(href='https://drawphone.tannerkrewson.com/archive', target='_blank', rel='noopener') Older results
  div#waiting.d-none
    div.row.justify-content-center
      div.col-sm-8
        #waiting-active
          h5 Still waiting for:
          ul#waiting-players.list-unstyled.row
        #waiting-vacant.d-none
          h5 Open seats
          ul#waiting-vacant-players.list-unstyled.row
        p#waiting-next-round.d-none Waiting for an open seat. You can also join the next round.
    dialog#replace-seat(aria-labelledby='replace-seat-title')
      form(method='dialog')
        h5#replace-seat-title
        label(for='replace-seat-player') Choose a player
        select#replace-seat-player.form-control.mb-3
        .btn-toolbar
          button.btn.btn-default.mr-2(value='cancel') Cancel
          button.btn.btn-default(value='replace') Replace
