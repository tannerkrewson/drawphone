#result.d-none
  .btn-toolbar.mb-3
    button#result-export.btn.btn-default(type='button') Export chain as image
  p#result-export-status.text-danger(role='alert')
  #result-content
  br
  #result-others.btn-group-vertical
  br
  br
  .btn-toolbar#result-buttons
    button#result-done.btn.btn-default.btn-lg(type='button') Done
  dialog#result-export-preview(aria-labelledby='result-export-title')
    h4#result-export-title Chain image
    .btn-toolbar.mb-3
      a#result-export-download.btn.btn-default.mr-2(download) Download PNG
      button#result-export-close.btn.btn-default(type='button') Close
    img#result-export-image(alt='Exported Drawphone chain')
