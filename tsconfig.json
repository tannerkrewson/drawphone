{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["vite/client", "node"]
    },
    "include": ["**/*.ts"]
}
